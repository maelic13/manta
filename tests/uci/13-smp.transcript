# Four search workers share bounded work while worker zero publishes one legal result.
@phase 6.2
> Manta {{VERSION}} by Miloslav Macurek
< setoption name Threads value 4
< position startpos
< go nodes 20000
! allow-info begin
> {{BESTMOVE_LINE}}
! allow-info end
< setoption name Threads value 1
< ucinewgame
< position startpos
< go depth 4
! allow-info begin
> {{BESTMOVE_LINE}}
! allow-info end
< quit
! exit 0 within 1000ms

---

# Quit cancels and joins every helper without publishing a partial helper result.
@phase 6.2
> Manta {{VERSION}} by Miloslav Macurek
< setoption name Threads value 4
< position startpos
< go infinite
! allow-info begin
< quit
! exit 0 within 1000ms
! allow-info end

---

# Every completed depth reaches the interface once, in depth order, with any thread count.
@phase 6.3
> Manta {{VERSION}} by Miloslav Macurek
< setoption name Threads value 4
< ucinewgame
< position startpos
< go depth 10
! allow-info begin
> info depth 1 {{ITERATION_FIELDS}}
> info depth 2 {{ITERATION_FIELDS}}
> info depth 3 {{ITERATION_FIELDS}}
> info depth 4 {{ITERATION_FIELDS}}
> info depth 5 {{ITERATION_FIELDS}}
> info depth 6 {{ITERATION_FIELDS}}
> info depth 7 {{ITERATION_FIELDS}}
> info depth 8 {{ITERATION_FIELDS}}
> info depth 9 {{ITERATION_FIELDS}}
> info depth 10 {{ITERATION_FIELDS}}
> {{BESTMOVE_LINE}}
! allow-info end
< setoption name Threads value 1
< ucinewgame
< position startpos
< go depth 10
! allow-info begin
> info depth 1 {{ITERATION_FIELDS}}
> info depth 2 {{ITERATION_FIELDS}}
> info depth 3 {{ITERATION_FIELDS}}
> info depth 4 {{ITERATION_FIELDS}}
> info depth 5 {{ITERATION_FIELDS}}
> info depth 6 {{ITERATION_FIELDS}}
> info depth 7 {{ITERATION_FIELDS}}
> info depth 8 {{ITERATION_FIELDS}}
> info depth 9 {{ITERATION_FIELDS}}
> info depth 10 {{ITERATION_FIELDS}}
> {{BESTMOVE_LINE}}
! allow-info end
< quit
! exit 0 within 1000ms
