* text=auto

# Vendored third-party source is stored byte-for-byte as published upstream.
# Line-ending normalization would change the content that
# config/fathom-vendor.json pins by SHA-256 and make the update procedure
# unverifiable, so exclude it from all text conversion.
third_party/** -text

.editorconfig text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
LICENSE text eol=lf
*.zig text eol=lf
*.zon text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ps1 text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.transcript text eol=lf

*.bin binary
*.nnue binary
*.pgn binary
*.png binary
*.ico binary
